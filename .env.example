# Backend API Port & Host
PORT=3001
HOST=127.0.0.1

# Private CSV Storage Path (must remain outside public/ and dist/)
CONTACT_CSV_PATH=./server/data/contact-submissions.csv

# Rate Limiting (window in ms and max requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=8

# Allowed CORS Origin in Production
CORS_ORIGIN=*
