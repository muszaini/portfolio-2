# ==============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Vercel Project Settings / .env.local)
# Never prefix these with VITE_ — they must stay strictly server-side.
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: comma-separated list of permitted browser origins for POST /api/enquiries
# Example: https://muszainimusa.com,https://www.muszainimusa.com
ALLOWED_ORIGIN=

# ==============================================================================
# PUBLIC CLIENT ENVIRONMENT VARIABLES (Safe for browser bundle)
# Leave blank if not yet published; the UI degrades gracefully without fake links.
# ==============================================================================
VITE_SITE_URL=https://your-portfolio-domain.vercel.app
VITE_GITHUB_URL=https://github.com/your-username
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
VITE_CONTACT_EMAIL=
VITE_CV_URL=

# Optional per-project GitHub & Live Demo URLs (leave blank if private or not live yet)
VITE_PROJECT_LAWFLOW_GITHUB=
VITE_PROJECT_LAWFLOW_DEMO=
VITE_PROJECT_RESTAURANT_GITHUB=
VITE_PROJECT_RESTAURANT_DEMO=
VITE_PROJECT_SKILLSWAP_GITHUB=
VITE_PROJECT_SKILLSWAP_DEMO=
VITE_PROJECT_HIBAH_GITHUB=
VITE_PROJECT_HIBAH_DEMO=
