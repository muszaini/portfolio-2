# Server Port and Host
PORT=3001
HOST=127.0.0.1

# Private CSV Storage Path (must be outside public/ and dist/)
CONTACT_CSV_PATH=./server/data/contact-submissions.csv

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=8

# Allowed CORS Origin in Production (e.g. https://muszainimusa.com)
CORS_ORIGIN=*
