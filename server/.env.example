# Server Port
PORT=5001

# Allowed Frontend Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Private storage location for CSV enquiry submissions
# Ensure this directory is mounted on persistent storage in production
STORAGE_FILE_PATH=./data/contact-submissions.csv

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
